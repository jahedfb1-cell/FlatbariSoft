# Copy to ".env" in the site folder on the server and fill in DB_PASSWORD. NEVER commit the real file.
APP_NAME="Green Valley BMS"
APP_ENV=production
APP_DEBUG=false
APP_KEY=__GENERATE_WITH_php_artisan_key:generate_--show__
APP_URL=https://house.dhakablinds.shop
APP_LOCALE=bn

LOG_CHANNEL=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u574978612_house
DB_USERNAME=u574978612_house
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
# E-mail is what "forgot password" uses: put a real mailbox here and change MAIL_MAILER to smtp.
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Green Valley BMS"
